rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && userDoc().perfil == 'Administrador'; }
    function samePosto(postoId) { return signedIn() && userDoc().postoId == postoId; }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /postos/{postoId} {
      allow read: if isAdmin() || samePosto(postoId);
      allow create, update, delete: if isAdmin();
    }

    match /postos/{postoId}/{colecao}/{docId} {
      allow read, write: if isAdmin() || samePosto(postoId);
    }

    match /{colecao}/{docId} {
      allow read, write: if isAdmin() || (signedIn() && resource.data.postoId == userDoc().postoId);
    }
  }
}
